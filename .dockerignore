banner.png

# Isolated worktrees (dot and underscore). Sending these is a multi-GB context bomb.
.worktrees/
_worktrees/

# Tests — exclude only the heavy e2e dirs. Keep tests/ibctesting (tiny, imported
# by x/smart-account tests; `go mod tidy`/`go vet` resolve it) in context.
tests/interchaintest/
tests/tsh/
**/target/
**/target
**/node_modules
vendor/
crates/
websites/
.git
.git/

# Staged zk-deps: Go source only. muslc lives in build/wasmvm/.
build/zk-deps/**/.git
build/zk-deps/zk-wasmvm/libwasmvm/target/
build/zk-deps/zk-wasmvm/artifacts/
build/zk-deps/zk-wasmvm/testdata/
build/zk-deps/zk-wasmvm/builders/
build/zk-deps/zk-wasmvm/internal/api/*.a
build/wasmvm-release/

# Do not ship local artifacts into the image context
build/release/
build/*.tar.gz
build/terpd*
notes/
optimizer/
permissionless.money/
terp.network/
scripts/scenarios/
app/upgrades/v520/upgradeHandlerDebug.json
*.tar.gz
*.tar.lz4
