# Test directories - ignore all target and data directories
tests/**/target/
tests/**/data/

# Rust build artifacts in staged zk-deps (if present)
build/zk-deps/zk-wasmvm/libwasmvm/target/

# Git directories
.git
build/zk-deps/**/.git

# Dependencies
**/node_modules
**/target
vendor/
crates/
websites/

# Isolated worktrees must not enter the image context (wasmvm .a I/O bombs).
_worktrees/

# Do not ship local artifacts into the reproducible-binary context
build/release/
build/*.tar.gz
build/terpd*
notes/
optimizer/
permissionless.money/
terp.network/
scripts/scenarios/
app/upgrades/v520/upgradeHandlerDebug.json
