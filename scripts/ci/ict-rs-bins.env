# Pinned ict-ci tarball for E2E. Bump tag when bins change.
# Object lives at releases/ict-rs/<tag>/ on host MinIO.
# Public hostname: minio.terp.network currently serves this object (200).
# s3.terp.network is the same path layout but CF still 404s that hostname.
ICT_RS_PROJECT=ict-rs
ICT_RS_RELEASE=v0.1.0
ICT_RS_TARBALL=ict-ci-linux-x86_64.tar.gz
ICT_RS_BINS_URL=https://minio.terp.network/releases/ict-rs/v0.1.0/ict-ci-linux-x86_64.tar.gz
