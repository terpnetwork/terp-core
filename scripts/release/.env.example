# Copy to scripts/release/.env (gitignored) and fill in.
# Loaded automatically by: cargo run -p terp-upgrade-proposal
# or: make upgrade-proposal

# Cosmos HD mnemonic for morocco-1 (cw-orch MAIN_MNEMONIC).
MAIN_MNEMONIC="word1 word2 ... word24"

# Chain connection (gRPC is required by cw-orch-daemon).
CHAIN_ID=morocco-1
CHAIN_KIND=mainnet
GAS_DENOM=uterp
GAS_PRICE=0.025
ADDRESS_PREFIX=terp
GRPC_URL=http://127.0.0.1:9090

# Optional
# LCD_URL=https://rest.terp.network
# STATE_FILE=./scripts/release/.cw-orch-state.json
# RUST_LOG=info
