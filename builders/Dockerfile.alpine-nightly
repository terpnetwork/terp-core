# Alpine muslc builder for libwasmvm 4.0.0-zk.
# Path A Stwo hosts need rustc nightly (portable_simd). Do not use 1.86.
FROM --platform=linux/amd64 rust:1.88.0-alpine

RUN apk add --no-cache ca-certificates build-base \
  llvm17-dev llvm17-static clang17-dev clang17-static \
  libxml2-static ncurses-static zlib-static zstd-static

ENV LLVM_CONFIG_PATH=/usr/bin/llvm-config-17
ENV LIBCLANG_PATH=/usr/lib/llvm17/lib

RUN rustup toolchain install nightly --profile minimal \
  && rustup default nightly \
  && rustup target add aarch64-unknown-linux-musl x86_64-unknown-linux-musl

RUN wget https://musl.cc/aarch64-linux-musl-cross.tgz \
  && tar -xf aarch64-linux-musl-cross.tgz \
  && mv ./aarch64-linux-musl-cross /opt \
  && /opt/aarch64-linux-musl-cross/bin/aarch64-linux-musl-gcc --version \
  && rm aarch64-linux-musl-cross.tgz

RUN chmod -R 777 /usr/local/cargo

WORKDIR /code

COPY guest/*.sh /opt/
RUN chmod +x /opt/*.sh

RUN mkdir /.cargo
RUN chmod +rx /.cargo
COPY guest/cargo-config.toml /.cargo/config.toml

CMD ["/opt/build_muslc.sh"]
